/* Search operators, explained one line at a time in the suggestion list. These
   are the whole reason the suggestions exist: nobody guesses "has:attachment". */

"Mail from a person" = "Mail from a person";
"Mail sent to a person" = "Mail sent to a person";
"Words in the subject line" = "Words in the subject line";
"Only mail with a file attached" = "Only mail with a file attached";
"Only mail you haven't read" = "Only mail you haven't read";
"Only mail you starred" = "Only mail you starred";
"One mailbox, such as in:inbox" = "One mailbox, such as in:inbox";
"Mail since a date, like 2024-01-31" = "Mail since a date, like 2024-01-31";
"Mail up to a date, like 2024-01-31" = "Mail up to a date, like 2024-01-31";

/* The filter chips over search results. Each one writes its operator into the
   query, so these words name the same thing the tokens below them do. */

"Unread" = "Unread";
"Has attachment" = "Has attachment";
"Past week" = "Past week";
"Past month" = "Past month";
"Past year" = "Past year";

/* Creating, renaming and deleting a label. Each refusal names the rule the
   server applied rather than saying the change failed: "there's already one
   called that" tells you what to type next, "the server didn't accept that"
   does not. */

"A label needs a name." = "A label needs a name.";
"A label name can't contain a slash. Use a parent label to nest it." = "A label name can't contain a slash. Use a parent label to nest it.";
"There's already a label with that name here." = "There's already a label with that name here.";
"Delete the labels nested inside this one first." = "Delete the labels nested inside this one first.";
"Built-in labels like Inbox and Sent can't be changed." = "Built-in labels like Inbox and Sent can't be changed.";
"That label no longer exists." = "That label no longer exists.";
"Your labels changed elsewhere. Try again." = "Your labels changed elsewhere. Try again.";
"The server didn't make that change." = "The server didn't make that change.";
"The server didn't accept that change." = "The server didn't accept that change.";
/* Find within an open conversation. The count is the whole point of the bar,
   so it is a sentence about position rather than a bare fraction. */

"No matches" = "No matches";
"%lld of %lld" = "%lld of %lld";
"Mail copied to a person" = "Mail copied to a person";
"One label, by its exact name" = "One label, by its exact name";

/* Onboarding: the typed address carried user:password@, which would be baked
   into every request and into the Keychain metadata. */
"Leave the username and password out of the address — the app password goes in the field below." = "Leave the username and password out of the address — the app password goes in the field below.";

/* Labels: refused locally rather than by the server, because the round trip
   would come back as a bare invalidProperties with nothing naming the rule. */
"A label can't be nested inside itself." = "A label can't be nested inside itself.";

/* Notifications. These are read aloud by Announce Notifications and shown on a
   lock screen, which is the one place in the app the user cannot correct a
   wrong language by looking somewhere else — the Android client shipped a
   German device reading a German inbox out in English. */
"Unknown sender" = "Unknown sender";
"(no subject)" = "(no subject)";
"Mark as read" = "Mark as read";
"Reply" = "Reply";
"Send" = "Send";
"Reply to this message" = "Reply to this message";
"Your reply hasn't been sent" = "Your reply hasn't been sent";
"It's queued and will go out when the server answers." = "It's queued and will go out when the server answers.";
"Try again" = "Try again";
"%lld new messages" = "%lld new messages";

/* Drafts. A composer that silently saves and one that silently does not look
   identical, so every one of these names where the text actually is. */
"Couldn't reach the server. Showing the draft last synced." = "Couldn't reach the server. Showing the draft last synced.";
"The server wouldn't save this draft." = "The server wouldn't save this draft.";
"This draft changed somewhere else. Reopen it to see the newest copy." = "This draft changed somewhere else. Reopen it to see the newest copy.";
"Sign in again to save this." = "Sign in again to save this.";
"Couldn't reach the server. This is still on your phone." = "Couldn't reach the server. This is still on your phone.";

/* Attachments refused at pick time, by name. A message that goes out with the
   first 25 MB of a video looks to the sender like it worked. */
"%@ is %@. This server accepts attachments up to %@." = "%1$@ is %2$@. This server accepts attachments up to %3$@.";
"%@ is stored on %@ and can't move to another account. Remove it, or send from %@." = "%@ is stored on %@ and can't move to another account. Remove it, or send from %@.";
"Adding %@ would take this message to %@. The limit is %@." = "Adding %1$@ would take this message to %2$@. The limit is %3$@.";

/* The quoted original and the forward header block. Hardcoded English above a
   German thread is the failure these replace. */
"On %@, %@ wrote:" = "On %1$@, %2$@ wrote:";
"---------- Forwarded message ----------" = "---------- Forwarded message ----------";
"From:" = "From:";
"Date:" = "Date:";
"Subject:" = "Subject:";
"To:" = "To:";
"Cc:" = "Cc:";

/* The offline action queue. Three sentences, deliberately distinct: the server
   knows, the server has not been told yet, or the server said no. Collapsing
   the middle one tells someone on a train that their mail has moved when it
   has not. */
"waiting for the server" = "waiting for the server";
"Put back" = "Put back";
"Moved to %@" = "Moved to %@";
"The server wouldn't move that conversation." = "The server wouldn't move that conversation.";
"This server is too old to move mail in or out of Trash or Spam." = "This server is too old to move mail in or out of Trash or Spam.";
"That server's certificate no longer matches." = "That server's certificate no longer matches.";
"You're offline." = "You're offline.";
"Nothing on %@ answered." = "Nothing on %@ answered.";
"Your server won't hold mail this far ahead. This phone will send it." = "Your server won't hold mail this far ahead. This phone will send it.";

